    "/v1/disclosures/{receipt}/handling-reports/{report}": {
      "put": {
        "operationId": "reportHandling",
        "summary": "Record a recipient handling assertion",
        "tags": [
          "Post-disclosure"
        ],
        "description": "Authenticated recipient report. Identical report retries retain the original. A reported deletion or retention exception has verification=reported.",
        "security": [
          {
            "presenterMTLS": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "action": {
                      "type": "string",
                      "enum": [
                        "retained",
                        "deleted",
                        "retention_exception"
                      ]
                    },
                    "exception_code": {
                      "type": "string",
                      "enum": [
                        "legal_hold",
                        "statutory_retention"
                      ]
                    },
                    "occurred_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "receipt_id": {
                      "type": "string"
                    },
                    "report_id": {
                      "type": "string"
                    },
                    "producer_id": {
                      "type": "string"
                    },
                    "terms_version": {
                      "type": "string"
                    },
                    "terms_digest": {
                      "type": "string"
                    },
                    "verification": {
                      "type": "string",
                      "const": "reported"
                    },
                    "recorded_at": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "action",
                    "occurred_at"
                  ],
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "action": {
                            "const": "retention_exception"
                          }
                        }
                      },
                      "then": {
                        "required": [
                          "exception_code"
                        ]
                      },
                      "else": {
                        "not": {
                          "required": [
                            "exception_code"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Caller or route unavailable 404, invalid body 400, conflicting retry or state 409, dependency unavailable 503."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "action": {
                    "type": "string",
                    "enum": [
                      "retained",
                      "deleted",
                      "retention_exception"
                    ]
                  },
                  "exception_code": {
                    "type": "string",
                    "enum": [
                      "legal_hold",
                      "statutory_retention"
                    ]
                  },
                  "occurred_at": {
                    "type": "string",
                    "format": "date-time"
                  }
                },
                "required": [
                  "action",
                  "occurred_at"
                ],
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "action": {
                          "const": "retention_exception"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "exception_code"
                      ]
                    },
                    "else": {
                      "not": {
                        "required": [
                          "exception_code"
                        ]
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "parameters": [
          {
            "name": "receipt",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "report",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/internal/v1/rights-cases/{role}/{actor}": {
