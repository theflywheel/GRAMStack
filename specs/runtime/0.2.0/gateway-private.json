            }
          }
        ]
      }
    },
    "/internal/v1/rights-cases/{role}/{actor}/{case}/{event}": {
      "put": {
        "operationId": "updateOperatorCase",
        "summary": "Acknowledge, resolve or report a case exception",
        "tags": [
          "Rights operators"
        ],
        "description": "Only queued \u2192 acknowledged \u2192 resolved or exception. An identical event retry returns its original acknowledgement.",
        "security": [
          {
            "serviceMTLS": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "action": {
                      "type": "string",
                      "enum": [
                        "acknowledge",
                        "resolve",
                        "record_exception"
                      ]
                    },
                    "exception_code": {
                      "type": "string",
                      "enum": [
                        "legal_hold",
                        "statutory_retention",
                        "insufficient_information"
                      ]
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "acknowledged",
                        "resolved",
                        "exception"
                      ]
                    },
                    "status_version": {
                      "type": "integer"
                    },
                    "recorded_at": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "action"
                  ],
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "action": {
                            "const": "record_exception"
                          }
                        }
                      },
                      "then": {
                        "required": [
                          "exception_code"
                        ]
                      },
                      "else": {
                        "not": {
                          "required": [
                            "exception_code"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Caller or route unavailable 404, invalid body 400, conflicting retry or state 409, dependency unavailable 503."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "action": {
                    "type": "string",
                    "enum": [
                      "acknowledge",
                      "resolve",
                      "record_exception"
                    ]
                  },
