                      },
                      "due_at": {
                        "type": "string",
                        "format": "date-time"
                      }
                    },
                    "required": [
                      "case_id",
                      "case_type",
                      "status",
                      "status_version",
                      "created_at",
                      "due_at"
                    ]
                  }
                }
              }
            }
          },
          "default": {
            "description": "Caller or route unavailable 404, invalid body 400, conflicting retry or state 409, dependency unavailable 503."
          }
        },
        "parameters": [
