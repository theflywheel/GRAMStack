              "application/json": {
                "schema": {
                  "$ref": "../../0.3.0/schemas.json#/$defs/DataResponse"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "const": "no-store"
                }
              },
              "Gramstack-Contract-Version": {
                "description": "Implemented core request lifecycle contract. Independent profiles retain their own version headers.",
                "schema": {
                  "type": "string",
                  "const": "0.3.0"
                }
              }
            }
          },
