{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.gramstack.try-dough.com/static/specs/adapter-discovery/0.1.0/schemas.json",
  "title": "GRAMStack adapter discovery 0.1.0",
  "$defs": {
    "Manifest": {
      "allOf": [
        {
          "$ref": "https://docs.gramstack.try-dough.com/static/specs/0.3.0/schemas.json#/$defs/AdapterManifest"
        },
        {
          "type": "object",
          "properties": {
            "signing_key_ids": {
              "type": "array",
              "maxItems": 16
            },
            "verification_methods": {
              "type": "array",
              "maxItems": 16
            },
            "resources": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "object",
                "properties": {
                  "fields": {
                    "type": "array",
                    "maxItems": 128
                  }
                }
              }
            }
          }
        }
      ]
    },
    "PublicJWK": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kty",
        "crv",
        "x",
        "y",
        "kid",
        "alg",
        "use"
      ],
      "properties": {
        "kty": {
          "const": "EC"
        },
        "crv": {
          "const": "P-256"
        },
        "x": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
        },
        "y": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
        },
        "kid": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "alg": {
          "const": "ES256"
        },
        "use": {
          "const": "sig"
        }
      }
    },
    "PublicKeySet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keys"
      ],
      "properties": {
        "keys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/PublicJWK"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
