{
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infra/railway/dedi/Dockerfile",
    "watchPatterns": ["/infra/railway/dedi/**", "/tools/runtimefiles/**"]
  },
  "deploy": {
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
