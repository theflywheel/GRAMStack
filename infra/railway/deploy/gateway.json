{
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "services/gateway/Dockerfile"
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3,
    "healthcheckPath": "/readyz",
    "healthcheckTimeout": 30,
    "preDeployCommand": [
      "/app/runtimefiles /app/service migrate"
    ]
  }
}
